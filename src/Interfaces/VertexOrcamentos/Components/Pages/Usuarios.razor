@page "/usuarios"
@inject UsuarioService UsuarioService
@inject ISnackbar Snackbar

<PageTitle>Vertex | Usuarios</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="usuarios-page">
    <div class="usuarios-header">
        <div>
            <MudText Typo="Typo.h3" Class="title-text">Usuarios</MudText>
            <MudText Typo="Typo.body1" Class="subtitle-text">
                Gerencie administradores e funcionarios do sistema
            </MudText>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Style="border-radius: 12px; font-weight:800; color:white;"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="NovoUsuario">
            Criar Usuario
        </MudButton>
    </div>

    <MudPaper Class="filter-box" Elevation="0">
        <MudTextField T="string"
                      Value="@busca"
                      Placeholder="Buscar por nome, email, login ou permissao"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="350"
                      ValueChanged="BuscarAsync" />
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(mensagemErro))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@mensagemErro</MudAlert>
    }

    <MudPaper Elevation="8" Class="usuarios-box">
        <MudTable Items="@usuarios"
                  Hover="true"
                  Loading="@carregando"
                  Striped="false"
                  Bordered="false"
                  Dense="false"
                  Class="usuarios-table usuarios-list-table"
                  RowClass="custom-row">
            <HeaderContent>
                <MudTh>Usuario</MudTh>
                <MudTh Class="hide-mobile">Email</MudTh>
                <MudTh>Permissao</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Acoes</MudTh>
            </HeaderContent>
            <RowTemplate>
                    <MudTd>
                        <div class="user-info">
                            <MudAvatar Size="Size.Medium" Color="Color.Primary">
                                @PrimeiraLetra(context.Nome)
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body1">@context.Nome</MudText>
                                <MudText Typo="Typo.caption" Class="user-id">Login: @context.Login</MudText>
                                <MudText Typo="Typo.caption" Class="user-email-mobile">@context.Email</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd Class="hide-mobile">@context.Email</MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Color="@(context.IsAdmin ? Color.Error : Color.Info)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @(context.IsAdmin ? "Administrador" : "Funcionario")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Color="@(context.Ativo ? Color.Success : Color.Default)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @(context.Ativo ? "Ativo" : "Inativo")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <div class="acoes-area">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Default"
                                               Style="color: #42A5F5;"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               Disabled="@context.IsAdmin"
                                               OnClick="@(() => EditarUsuarioAsync(context.Id))" />
                            </MudTooltip>

                            <MudTooltip Text="Inativar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               Disabled="@(!context.Ativo || context.IsAdmin)"
                                               OnClick="@(() => InativarUsuarioAsync(context.Id))" />
                            </MudTooltip>
                        </div>
                    </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="empty-text">Nenhum usuario encontrado.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (formAberto)
    {
        <div class="modal-backdrop">
            <MudPaper Class="user-form" Elevation="12">
                <div class="form-header">
                    <MudText Typo="Typo.h5">@(form.Id.HasValue ? "Editar usuario" : "Criar usuario")</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="FecharFormulario" />
                </div>

                <MudForm @ref="mudForm">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="form.Nome" Label="Nome" Variant="Variant.Outlined" Required="true" MaxLength="20" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="form.Cpf" Label="CPF" Variant="Variant.Outlined" Required="true" MaxLength="14" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="form.Telefone" Label="Telefone" Variant="Variant.Outlined" Required="true" MaxLength="20" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="form.Email" Label="Email" Variant="Variant.Outlined" Required="true" MaxLength="120" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="form.Endereco" Label="Endereco" Variant="Variant.Outlined" Required="true" MaxLength="100" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="form.Login" Label="Login" Variant="Variant.Outlined" Required="true" MaxLength="36" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="form.Senha"
                                          Label="@(form.Id.HasValue ? "Nova senha (opcional)" : "Senha")"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          Required="@(!form.Id.HasValue)"
                                          MaxLength="50" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="form.Cargo" Label="Permissao" Variant="Variant.Outlined">
                                <MudSelectItem Value="@("Admin")">Administrador</MudSelectItem>
                                <MudSelectItem Value="@("Funcionario")">Funcionario</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                            <MudSwitch @bind-Value="form.Ativo" Color="Color.Success" Label="Usuario ativo" />
                        </MudItem>
                    </MudGrid>
                </MudForm>

                <div class="form-actions">
                    <MudButton Variant="Variant.Text" OnClick="FecharFormulario">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@salvando"
                               OnClick="SalvarUsuarioAsync">
                        Salvar
                    </MudButton>
                </div>
            </MudPaper>
        </div>
    }
</MudContainer>

<style>
html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    overflow-x: hidden;
}

.usuarios-page {
    min-height: 100vh;
    padding: 40px;
    background: linear-gradient(135deg, #071D36, #0B3A6A, #4FC3F7);
}

.usuarios-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    gap: 20px;
    flex-wrap: wrap;
}

.title-text {
    color: white;
    font-weight: 700;
}

.subtitle-text {
    color: rgba(255,255,255,0.75);
    margin-top: 6px;
}

.filter-box {
    background: rgba(18,56,92,0.88) !important;
    border-radius: 16px;
    padding: 18px;
    margin-bottom: 18px;
}

.usuarios-box {
    background: rgba(18,56,92,0.88) !important;
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.35);
    overflow-x: auto;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 15px;
}

.user-id, .user-email-mobile {
    color: rgba(255,255,255,0.60);
}

.user-email-mobile {
    display: none;
    margin-top: 2px;
}

.acoes-area {
    display: flex;
    gap: 6px;
    align-items: center;
}

.custom-row {
    transition: 0.2s;
}

.custom-row:hover {
    background-color: rgba(255,255,255,0.06) !important;
}

.action-btn {
    transition: 0.2s;
    border-radius: 10px;
}

.action-btn:hover {
    transform: scale(1.12);
    background-color: rgba(255,255,255,0.08);
}

.empty-text {
    color: rgba(255,255,255,0.72);
    padding: 18px;
}

.mud-table {
    background: transparent !important;
    width: 100% !important;
    table-layout: fixed;
}

.usuarios-table {
    min-width: 820px;
}

.usuarios-list-table th:nth-child(1), .usuarios-list-table td:nth-child(1) { width: 34%; }
.usuarios-list-table th:nth-child(2), .usuarios-list-table td:nth-child(2) { width: 26%; }
.usuarios-list-table th:nth-child(3), .usuarios-list-table td:nth-child(3) { width: 16%; }
.usuarios-list-table th:nth-child(4), .usuarios-list-table td:nth-child(4) { width: 12%; }
.usuarios-list-table th:nth-child(5), .usuarios-list-table td:nth-child(5) { width: 12%; }

.mud-table-head th {
    color: white !important;
    font-size: 15px;
    font-weight: 600;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    white-space: nowrap;
}

.mud-table-body td {
    color: white !important;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    vertical-align: middle;
    overflow-wrap: anywhere;
}

.mud-button-filled-primary, .mud-avatar {
    background-color: #3B82F6 !important;
    color: white !important;
}

.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(2, 6, 23, 0.68);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px;
    z-index: 1300;
}

.user-form {
    width: min(900px, 100%);
    max-height: 92vh;
    overflow-y: auto;
    padding: 28px;
    border-radius: 16px;
}

.form-header, .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.form-header {
    margin-bottom: 24px;
}

.form-actions {
    justify-content: flex-end;
    margin-top: 24px;
}

@@media (max-width: 900px) {
    .usuarios-page {
        padding: 20px;
    }

    .hide-mobile {
        display: none !important;
    }

    .usuarios-table {
        min-width: 620px;
    }

    .user-email-mobile {
        display: block;
    }
}

@@media (max-width: 480px) {
    .usuarios-page {
        padding: 12px;
    }

    .title-text {
        font-size: 1.5rem !important;
    }

    .usuarios-box, .filter-box {
        padding: 10px;
        border-radius: 12px;
    }
}
</style>

@code {
    private readonly List<UsuarioListItem> usuarios = [];
    private MudForm? mudForm;
    private UsuarioFormModel form = new();
    private string? busca;
    private string? mensagemErro;
    private bool carregando;
    private bool salvando;
    private bool formAberto;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuariosAsync();
    }

    private async Task BuscarAsync(string termo)
    {
        busca = termo;
        await CarregarUsuariosAsync();
    }

    private async Task CarregarUsuariosAsync()
    {
        try
        {
            carregando = true;
            mensagemErro = null;
            usuarios.Clear();
            usuarios.AddRange(await UsuarioService.ListarAsync(busca));
        }
        catch (Exception ex)
        {
            mensagemErro = $"Nao foi possivel carregar usuarios: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    private void NovoUsuario()
    {
        form = new UsuarioFormModel();
        formAberto = true;
    }

    private async Task EditarUsuarioAsync(Guid id)
    {
        var usuario = await UsuarioService.ObterAsync(id);
        if (usuario is null)
        {
            Snackbar.Add("Usuario nao encontrado.", Severity.Warning);
            return;
        }

        form = usuario;
        formAberto = true;
    }

    private async Task SalvarUsuarioAsync()
    {
        if (mudForm is null)
        {
            return;
        }

        await mudForm.ValidateAsync();
        if (!mudForm.IsValid)
        {
            return;
        }

        try
        {
            salvando = true;

            if (form.Id.HasValue)
            {
                await UsuarioService.AtualizarAsync(form.Id.Value, form);
                Snackbar.Add("Usuario atualizado com sucesso.", Severity.Success);
            }
            else
            {
                await UsuarioService.CriarAsync(form);
                Snackbar.Add("Usuario criado com sucesso.", Severity.Success);
            }

            formAberto = false;
            await CarregarUsuariosAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task InativarUsuarioAsync(Guid id)
    {
        try
        {
            await UsuarioService.InativarAsync(id);
            Snackbar.Add("Usuario inativado com sucesso.", Severity.Success);
            await CarregarUsuariosAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void FecharFormulario()
    {
        formAberto = false;
    }

    private static string PrimeiraLetra(string valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "?" : valor.Trim()[0].ToString().ToUpperInvariant();
    }
}
