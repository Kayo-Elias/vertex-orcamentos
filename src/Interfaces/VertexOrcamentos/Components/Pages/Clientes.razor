@page "/clientes";

<PageTitle>Vertex | Clientes</PageTitle>

<MudPaper Class="pa-6" Elevation="0" Style="background-color: transparent;">

<div Row="true" class="d-flex justify-space-between align-center mb-1">
</div> 
    
 
<MudText Typo="Typo.h3"
         Style="font-weight:700; color:white;">
    Clientes
</MudText>

<MudText Typo="Typo.body1"
         Style="color:#94A3B8; margin-bottom:80px;">
    Gerencie e acompanhe o cadastro dos clientes
</MudText>


<MudStack Row="true"
          Spacing="2"
          Wrap="Wrap.Wrap"
          Class="mb-6">

    <MudButton
        Variant="Variant.Filled"
        Color="Color.Success"
        StartIcon="@Icons.Material.Filled.Add"
        Style="border-radius:12px; font-weight:600;">
        Criar
    </MudButton>

    <MudButton 
        Variant="Variant.Filled"
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Edit"
        Style="border-radius:12px; font-weight:600; color:white;">
        Editar
    </MudButton>
    
    <MudButton 
        Variant="Variant.Filled"
        Color="Color.Error"
        StartIcon="@Icons.Material.Filled.Delete"
        Style="border-radius:12px; font-weight:600;">
        Excluir
    </MudButton>

</MudStack>



<MudGrid Class="mt-2 mb-4">

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Total de Clientes
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:white;">
                128
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Clientes Ativos
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#22C55E;">
                98
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Pendentes
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#FACC15;">
                12
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Bloqueados
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#EF4444;">
                18
            </MudText>

        </MudPaper>
    </MudItem>

</MudGrid>

<MudPaper Class="pa-4 pa-sm-6"
          Elevation="0"
          Style="background-color:#111927; border-radius:16px;">

    <MudStack Row="true"
          Spacing="2"
          Wrap="Wrap.Wrap"
          AlignItems="AlignItems.Center">

        <MudTextField T="string"
                      Placeholder="Pesquisar cliente"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      FullWidth="true" />

        <MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           FullWidth="true"
           Style="border-radius: 10px;">git init
            Buscar
        </MudButton>

    </MudStack>

</MudPaper>
<MudTable Items="@clientes"
          Hover="true"
          Striped="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Class="mt-4">

    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Telefone</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Nome</MudTd>
        <MudTd>@context.Email</MudTd>
        <MudTd>@context.Telefone</MudTd>

        <MudTd>
           <MudChip T="string"
         Color="Color.Success">
    Ativo
</MudChip>
        </MudTd>
    </RowTemplate>

</MudTable>

</MudPaper>

@code {

    public class Cliente
    {
        public string Nome { get; set; }
        public string Email { get; set; }
        public string Telefone { get; set; }
    }

    private List<Cliente> clientes = new()
    {
        new Cliente
        {
            Nome = "Maria Silva",
            Email = "maria@email.com",
            Telefone = "(83) 99999-9999"
        },

        new Cliente
        {
            Nome = "João Pedro",
            Email = "joao@email.com",
            Telefone = "(83) 98888-8888"
        }
    };
}
