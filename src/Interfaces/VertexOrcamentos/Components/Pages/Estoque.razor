@page "/estoque";

<PageTitle>Vertex | Estoque</PageTitle>

<MudPaper Class="pa-6" Elevation="0" Style="background-color: transparent;">

<div Row="true" class="d-flex justify-space-between align-center mb-1">
</div> 
    
 
<MudText Typo="Typo.h3"
         Style="font-weight:700; color:white;">
    Estoque
</MudText>

<MudText Typo="Typo.body1"
         Style="color:#94A3B8; margin-bottom:80px;">
    Gerencie e acompanhe o estoque
</MudText>


<MudStack Row="true"
          Spacing="2"
          Wrap="Wrap.Wrap"
          Class="mb-6">

    <MudButton
        Variant="Variant.Filled"
        Color="Color.Success"
        StartIcon="@Icons.Material.Filled.Add"
        Style="border-radius:12px; font-weight:600;">
        Criar
    </MudButton>

    <MudButton 
        Variant="Variant.Filled"
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Edit"
        Style="border-radius:12px; font-weight:600; color:white;">
        Editar
    </MudButton>
    
    <MudButton 
        Variant="Variant.Filled"
        Color="Color.Error"
        StartIcon="@Icons.Material.Filled.Delete"
        Style="border-radius:12px; font-weight:600;">
        Excluir
    </MudButton>

</MudStack>



<MudGrid Class="mt-2 mb-4">

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Total de Produtos em Estoque
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:white;">
                128
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Produtos Ativos
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#22C55E;">
                98
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Produtos com baixo estoque
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#FACC15;">
                12
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Valor Total em Estoque
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#3B82F6;">
                R$ 45.320,00
            </MudText>

        </MudPaper>
    </MudItem>


</MudGrid>

<MudPaper Class="pa-4 pa-sm-6"
          Elevation="0"
          Style="background-color:#111927; border-radius:16px;">

    <MudStack Row="true"
          Spacing="2"
          Wrap="Wrap.Wrap"
          AlignItems="AlignItems.Center">

        <MudTextField T="string"
                      Placeholder="Pesquisar produto"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      FullWidth="true" />

        <MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           FullWidth="true"
           Style="border-radius: 10px;">
            Buscar  
        </MudButton>

    </MudStack>

</MudPaper>
<MudTable Items="@clientes"
          Hover="true"
          Striped="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Class="mt-4">

    <HeaderContent>
        <MudTh>ID</MudTh>
        <MudTh>Categoria</MudTh>
        <MudTh>Nome</MudTh>
        <MudTh>Valor</MudTh>
        <MudTh>Quantidade</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Categoria</MudTd>
        <MudTd>@context.Nome</MudTd>
        <MudTd>@context.Valor</MudTd>
        <MudTd>@context.Quantidade</MudTd>

    </RowTemplate>

</MudTable>

</MudPaper>

@code {

    public class Cliente
    {
        public string? Id { get; set; }
        public string? Categoria { get; set; }
        public string? Nome { get; set; }
        public double Valor { get; set; }
        public int Quantidade { get; set; }
    }

    private List<Cliente> clientes = new()
    {
        new Cliente
        {
            Id = "1",
            Categoria = "Eletrônicos",
            Nome = "Mouse",
            Valor = 100.00,
            Quantidade = 10
        },

        new Cliente
        {
            Id = "2",
            Categoria = "Eletrônicos",
            Nome = "Mouse",
            Valor = 150.00,
            Quantidade = 5
        }
    };
}
