@page "/estoque";
@using VertexOrcamentos.Components.Shared

<PageTitle>Vertex | Estoque</PageTitle>

<!-- titulo -->

<PageHeader
    Titulo="Estoque"
    Subtitulo="Gerencie e acompanhe o estoque da empresa de forma prática e organizada." 
    Imagem="https://www.shutterstock.com/image-photo/business-analyst-managing-data-infrastructure-600nw-2740363657.jpg"
    ImagemPosicao="center 53%"/>
<!-- botoes de criar, editar e excluir -->

<MudStack Row="true"
          Spacing="2"
          Wrap="Wrap.Wrap"
          Class="mb-6">

    <MudButton
        Variant="Variant.Filled"
        Color="Color.Success"
        StartIcon="@Icons.Material.Filled.Add"
        Style="border-radius:12px; font-weight:800;">
        Criar
    </MudButton>

    <MudButton 
        Variant="Variant.Filled"
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Edit"
        Style="border-radius:12px; font-weight:800; color:white;">
        Editar
    </MudButton>
    
    <MudButton 
        Variant="Variant.Filled"
        Color="Color.Error"
        StartIcon="@Icons.Material.Filled.Delete"
        Style="border-radius:12px; font-weight:800;">
        Excluir
    </MudButton>

</MudStack>

<!-- cards de resumo -->

<MudGrid Class="mt-2 mb-4">

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">

                Total de Produtos em Estoque
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight:700; color:white;">
                128
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Produtos Ativos
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#22C55E;">
                98
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Produtos com baixo estoque
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#FACC15;">
                12
            </MudText>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Valor Total em Estoque
            </MudText>

            <MudText Typo="Typo.h4" Style="font-weight:700; color:#3B82F6;">
                R$ 45.320,00
            </MudText>

        </MudPaper>
    </MudItem>


</MudGrid>

<!-- pesquisa e botao de buscar -->

<MudPaper Class="pa-4 pa-sm-6"
          Elevation="0"
          Style="background-color:#111927; border-radius:16px;">

    <MudStack Row="true"
          Spacing="2"
          Wrap="Wrap.Wrap"
          AlignItems="AlignItems.Center">

        <MudTextField T="string"
                      Placeholder="Pesquisar produto"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      FullWidth="true" />

        <MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           FullWidth="true"
           Style="border-radius: 12px; font-weight:800; color:white;">
            Buscar  
        </MudButton>

    </MudStack>

  </MudPaper>

  <!-- tabela -->

<MudPaper Class="usuarios-box">

    <MudTable Items="@clientes"
              Hover="true"
              Striped="false"
              Bordered="false"
              Dense="false"
              Class="usuarios-table">

        <HeaderContent>

            <MudTh>ID</MudTh>

            <MudTh>Categoria</MudTh>

            <MudTh>Nome</MudTh>

            <MudTh>Valor</MudTh>

            <MudTh>Quantidade</MudTh>

            <MudTh>Ações</MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTr Class="custom-row">

                <!-- ID -->
                <MudTd>

                    <div class="user-info">

                        <MudAvatar Size="Size.Medium"
                                   Color="Color.Primary">

                            @context.Nome.Substring(0,1)

                        </MudAvatar>

                        <div>

                            <MudText Typo="Typo.body1">
                                #@context.Id
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Class="user-id">

                                Produto em estoque

                            </MudText>

                        </div>

                    </div>

                </MudTd>

                <!-- Categoria -->
                <MudTd>
                    @context.Categoria
                </MudTd>

                <!-- Nome -->
                <MudTd>
                    @context.Nome
                </MudTd>

                <!-- Valor -->
                <MudTd>

                    <MudText Typo="Typo.body1"
                             Style="font-weight:600;">

                        R$ @context.Valor

                    </MudText>

                </MudTd>

                <!-- Quantidade -->
                <MudTd>

                    <MudChip T="string"
                             Color="Color.Info"
                             Variant="Variant.Filled"
                             Size="Size.Small">

                        @context.Quantidade unidades

                    </MudChip>

                </MudTd>

                <!-- Ações -->
                <MudTd>

                    <div class="acoes-area">

                        <MudTooltip Text="Editar">

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Default"
                                           Style="color: #42A5F5;"
                                           Size="Size.Small"
                                           Class="action-btn" />

                        </MudTooltip>

                        <MudTooltip Text="Excluir">

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Class="action-btn" />

                        </MudTooltip>

                    </div>

                </MudTd>

            </MudTr>

        </RowTemplate>

    </MudTable>

</MudPaper>

<!-- estilos da pagina -->

<style>

.usuarios-box {
    background: rgba(18,56,92,0.88) !important;
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 8px 30px rgba(78, 107, 120, 0.44);
}

.user-info {
    display: flex;
    align-items: center;
    gap: 15px;
}

.user-id {
    color: rgba(255,255,255,0.55);
}

.custom-row {
    transition: 0.2s;
}

.custom-row:hover {
    background-color: rgba(255,255,255,0.06) !important;
}

.acoes-area {
    display: flex;
    gap: 6px;
    align-items: center;
}

.action-btn {
    transition: 0.2s;
    border-radius: 10px;
}

.action-btn:hover {
    transform: scale(1.1);
    background-color: rgba(236, 173, 173, 0.08);
}

.mud-table {
    background: rgba(22, 57, 109, 0.5) !important;
}

.mud-table-head th {
    color: white !important;
    font-size: 15px;
    font-weight: 600;
    border-bottom: 1px solid rgba(151, 179, 190, 0.48);
}

.mud-table-body td {
    color: white !important;
    border-bottom: 1px solid rgba(151, 179, 190, 0.48);
}

.mud-avatar {
    background: #3B82F6 !important;
    color: white !important;
    font-weight: bold;
}

@@media (max-width: 768px) {

    .user-info {
        gap: 10px;
    }

    .mud-table-body td,
    .mud-table-head th {
        font-size: 13px;
    }
}

</style>

@code {

    public class Cliente
    {
        public string? Id { get; set; }
        public string? Categoria { get; set; }
        public string? Nome { get; set; }
        public double Valor { get; set; }
        public int Quantidade { get; set; }
    }

    private List<Cliente> clientes = new()
    {
        new Cliente
        {
            Id = "1",
            Categoria = "Eletrônicos",
            Nome = "Mouse",
            Valor = 100.00,
            Quantidade = 10
        },

        new Cliente
        {
            Id = "2",
            Categoria = "Eletrônicos",
            Nome = "Mouse",
            Valor = 150.00,
            Quantidade = 5
        }
    };
}
