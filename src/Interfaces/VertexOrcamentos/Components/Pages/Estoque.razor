@using System.Net.Http.Json

@page "/estoque"

<PageTitle>Vertex | Orcamentos</PageTitle>

 <MudText Typo="Typo.h3" Class="d-flex justify-center">ESTOQUE</MudText>
    
<MudDataGrid T="ItemEstoque" MultiSelection="true" Items="@Estoques" SortMode="SortMode.Multiple" Filterable="true" QuickFilter="@_quickFilter"
    Hideable="true" RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" SelectedItemsChanged="@SelectedItemsChanged">
    <ToolBarContent>
        <MudTextField @bind-Value="Pesquisa" Placeholder="Pesquisa" Adornment="Adornment.Start" Immediate="true" 
          AdornmentIcon="@Icons.Material.Filled.Search" Style="width:200px" IconSize="Size.Medium"></MudTextField>
    <MudStack Row="true" Spacing="2" Class="mb-4" Justify="Justify.FlexEnd">
    <MudSpacer/>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle">Criar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle">Editar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle">Excluir</MudButton>
    </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn T="ItemEstoque" color="Color.Primary" />
        <PropertyColumn Property="x => x.ID" Title="ID"/>
        <PropertyColumn Property="x => x.Categoria" Title="Categoria"/>
        <PropertyColumn Property="x => x.Nome" Title="Nome"/>
        <PropertyColumn Property="x => x.Valor" Title="Valor unitário"/>
        <PropertyColumn Property="x => x.Quantidade" Title="Estoque"/>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ItemEstoque" />
    </PagerContent>
</MudDataGrid>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch @bind-Value="@_sortNameByLength" Color="Color.Primary">Sort Name Column By Length</MudSwitch>
</div>

<MudExpansionPanels Style="flex:1">
    <MudExpansionPanel Text="Show Events">
        @foreach (var message in _events)
        {
            <MudText Typo="@Typo.body2">@message</MudText>
        }
        @if(_events.Count > 0) 
        {
            <div class="d-flex">
                <MudSpacer/>
                <MudButton Class="mt-3" ButtonType="ButtonType.Button" Variant="Variant.Filled" OnClick="@(() => _events.Clear())">Clear</MudButton>
            </div>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    public class ItemEstoque
    {
        public int ID { get; set; }
        public string Categoria { get; set; } = string.Empty;
        public string Nome { get; set; } = string.Empty;
        public double Valor { get; set; }
        public double Quantidade { get; set; }
    }

    private IEnumerable<ItemEstoque> Estoques = new List<ItemEstoque>();
    private string Pesquisa = string.Empty;
    private bool _sortNameByLength;
    private List<string> _events = new();
    // custom sort by name length
    private Func<ItemEstoque, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.Nome.Length;
        else
            return x.Nome;
    };
    // quick filter - filter globally across multiple columns with the same input
    private Func<ItemEstoque, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(Pesquisa))
            return true;

        if (x.Nome.Contains(Pesquisa, StringComparison.OrdinalIgnoreCase))
            return true;

        if ($"{x.ID} {x.Valor} {x.Quantidade}".Contains(Pesquisa, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    protected override async Task OnInitializedAsync()
    {
        // Mock data for demonstration
        Estoques = new List<ItemEstoque>
        {
            new ItemEstoque { ID = 1,  Categoria = "Teste", Nome = "Hydrogen",   Valor = 1.008,  Quantidade = 100 },
            new ItemEstoque { ID = 2,  Categoria = "Teste", Nome = "Helium",     Valor = 4.0026, Quantidade = 50 },
            new ItemEstoque { ID = 3,  Categoria = "Teste", Nome = "Lithium",    Valor = 6.94,   Quantidade = 75 },
            new ItemEstoque { ID = 4,  Categoria = "Teste", Nome = "Beryllium",  Valor = 9.0122, Quantidade = 25 },
            new ItemEstoque { ID = 5,  Categoria = "Teste", Nome = "Boron",      Valor = 10.81,  Quantidade = 30 },
            new ItemEstoque { ID = 6,  Categoria = "Teste", Nome = "Carbon",     Valor = 12.011, Quantidade = 40 },
            new ItemEstoque { ID = 7,  Categoria = "Teste", Nome = "Nitrogen",   Valor = 14.007, Quantidade = 60 },
            new ItemEstoque { ID = 8,  Categoria = "Teste", Nome = "Oxygen",     Valor = 15.999, Quantidade = 80 },
            new ItemEstoque { ID = 9,  Categoria = "Teste", Nome = "Fluorine",   Valor = 18.998, Quantidade = 20 },
            new ItemEstoque { ID = 10, Categoria = "Teste", Nome = "Neon",       Valor = 20.18,  Quantidade = 35 }
        };
    }

    // events
    void RowClicked(DataGridRowClickEventArgs<ItemEstoque> args)
    {
        _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void RowRightClicked(DataGridRowClickEventArgs<ItemEstoque> args)
    {
        _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void SelectedItemsChanged(HashSet<ItemEstoque> items)
    {
        _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
    }
}