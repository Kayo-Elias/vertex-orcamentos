@page "/relatorios"
@using VertexOrcamentos.Components.Shared

<PageTitle>Vertex | Relatórios</PageTitle>

    <!-- HEADER -->

           <PageHeader
    Titulo="Central de Relatórios"
    Subtitulo="Gere análises estratégicas e acompanhe o desempenho operacional do sistema" 
    Imagem="https://plus.unsplash.com/premium_photo-1661315406324-329dd27ebc34?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8cmVsYXQlQzMlQjNyaW98ZW58MHx8MHx8fDA%3D"
    ImagemPosicao="center"/>

<div class="d-flex justify-end mt-4 mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Download"
                   Class="mt-4 mb-4"
                   Style="border-radius: 12px;">
                  

            Exportar Relatório

        </MudButton>
</div> 
    <!-- RELATORIOS RAPIDOS -->

    <MudGrid>
       <!-- gerar relatorio -->

        <MudItem xs="12" md="3">

            <MudPaper Class="report-card" Elevation="0">

                <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                         Size="Size.Large"
                         Class="report-icon" />

                <MudText Typo="Typo.h6" Class="report-title">
                    Estoque Crítico
                </MudText>

                <MudText Class="report-text">
                    Produtos com quantidade baixa ou zerada
                </MudText>

                <MudButton Variant="Variant.Text"
                           Color="Color.Info"
                           Style="border-radius: 12px;">

                    Gerar relatório

                </MudButton>

            </MudPaper>

        </MudItem>

<!-- produtos parados -->
        <MudItem xs="12" md="3">

            <MudPaper Class="report-card">

                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                         Size="Size.Large"
                         Class="report-icon warning" />

                <MudText Typo="Typo.h6" Class="report-title">
                    Produtos Parados
                </MudText>

                <MudText Class="report-text">
                    Itens sem movimentação recente
                </MudText>

                <MudButton Variant="Variant.Text"
                           Color="Color.Warning"
                           Style="border-radius: 12px;">

                    Gerar relatório

                </MudButton>

            </MudPaper>

        </MudItem>

<!-- horario de pico -->
        <MudItem xs="12" md="3">

            <MudPaper Class="report-card">

                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                         Size="Size.Large"
                         Class="report-icon success" />

                <MudText Typo="Typo.h6" Class="report-title">
                    Horários de Pico
                </MudText>

                <MudText Class="report-text">
                    Períodos com maior fluxo de vendas
                </MudText>

                <MudButton Variant="Variant.Text"
                           Color="Color.Success"
                           Style="border-radius: 12px;">

                    Gerar relatório

                </MudButton>

            </MudPaper>

        </MudItem>
<!-- desempenho geral -->
        <MudItem xs="12" md="3">

            <MudPaper Class="report-card">

                <MudIcon Icon="@Icons.Material.Filled.Assessment"
                         Size="Size.Large"
                         Class="report-icon danger" />

                <MudText Typo="Typo.h6" Class="report-title">
                    Desempenho Geral
                </MudText>

                <MudText Class="report-text">
                    Eficiência operacional do sistema
                </MudText>

                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Style="border-radius: 12px;">

                    Gerar relatório

                </MudButton>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- ANALISES -->

    <MudGrid Class="mt-4">

        <MudItem xs="12" md="6">

            <MudPaper Class="analysis-box" Elevation="0">

                <MudText Typo="Typo.h5" Class="section-title">
                    Produtos com Baixa Saída
                </MudText>

                <div class="analysis-item">
                    <span>Mouse Gamer RGB</span>

                    <MudChip T="string" Color="Color.Warning">
                        3 vendas
                    </MudChip>
                </div>

                <div class="analysis-item">
                    <span>Teclado Mecânico</span>

                    <MudChip T="string" Color="Color.Warning">
                        2 vendas
                    </MudChip>
                </div>

                <div class="analysis-item">
                    <span>Headset Pro X</span>

                    <MudChip T="string" Color="Color.Error">
                        Sem vendas
                    </MudChip>
                </div>

            </MudPaper>

        </MudItem>

        <MudItem xs="12" md="6">

            <MudPaper Class="analysis-box">

                <MudText Typo="Typo.h5" Class="section-title">
                    Produtos Mais Vendidos
                </MudText>

                <div class="analysis-item">
                    <span>Mouse Office</span>

                    <MudChip T="string" Color="Color.Success">
                        128 vendas
                    </MudChip>
                </div>

                <div class="analysis-item">
                    <span>Notebook Dell</span>

                    <MudChip T="string" Color="Color.Success">
                        96 vendas
                    </MudChip>
                </div>

                <div class="analysis-item">
                    <span>Monitor LG</span>

                    <MudChip T="string" Color="Color.Info">
                        74 vendas
                    </MudChip>
                </div>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- ALERTAS -->

    <MudPaper Class="alerts-box mt-4" Elevation="0">

        <MudText Typo="Typo.h5" Class="section-title">
            Alertas Inteligentes
        </MudText>

        <div class="alert-item">

            <MudIcon Icon="@Icons.Material.Filled.Warning"
                     Color="Color.Warning" />

            <span>
                5 produtos estão próximos de acabar no estoque
            </span>

        </div>

        <div class="alert-item">

            <MudIcon Icon="@Icons.Material.Filled.Error"
                     Color="Color.Error" />

            <span>
                Produto “Notebook Acer” está sem movimentação há 30 dias
            </span>

        </div>

        <div class="alert-item">

            <MudIcon Icon="@Icons.Material.Filled.Info"
                     Color="Color.Info" />

            <span>
                Pico de vendas identificado entre 18h e 21h
            </span>

        </div>

    </MudPaper>

    <!-- RESUMO OPERACIONAL -->

    <MudPaper Class="summary-box mt-4" Elevation="0">

        <MudText Typo="Typo.h5" Class="section-title">
            Resumo Operacional
        </MudText>

        <MudGrid>

            <MudItem xs="12" md="4">

                <div class="summary-card">

                    <MudIcon Icon="@Icons.Material.Filled.AccessTime"
                             Color="Color.Info"
                             Size="Size.Large" />

                    <MudText Class="summary-number">
                        18 min
                    </MudText>

                    <MudText Class="summary-label">
                        Tempo médio de atendimento
                    </MudText>

                </div>

            </MudItem>

            <MudItem xs="12" md="4">

                <div class="summary-card">

                    <MudIcon Icon="@Icons.Material.Filled.Inventory"
                             Color="Color.Warning"
                             Size="Size.Large" />

                    <MudText Class="summary-number">
                        8
                    </MudText>

                    <MudText Class="summary-label">
                        Produtos em falta
                    </MudText>

                </div>

            </MudItem>

            <MudItem xs="12" md="4">

                <div class="summary-card">

                    <MudIcon Icon="@Icons.Material.Filled.DoneAll"
                             Color="Color.Success"
                             Size="Size.Large" />

                    <MudText Class="summary-number">
                        96%
                    </MudText>

                    <MudText Class="summary-label">
                        Eficiência operacional
                    </MudText>

                </div>

            </MudItem>

        </MudGrid>

    </MudPaper>


<style>

.report-card {
    padding: 28px 24px;
    border-radius: 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    backdrop-filter: blur(8px);
    transition: 0.3s ease;
}

.report-card:hover {
    transform: translateY(-8px);
    background: rgba(143, 199, 236, 0.1);
    border-color: rgba(66, 164, 245, 0.67);
    box-shadow: 0 12px 32px rgba(20, 189, 211, 0.25);
}

.report-icon {
    font-size: 30px !important;
    color: #42A5F5;
    margin-bottom: 18px;
}

.report-icon.warning { color: #FACC15; }
.report-icon.success { color: #22C55E; }
.report-icon.danger  { color: #EF4444; }

.report-title {
    color: white !important;
    font-weight: 700;
    font-size: 18px !important;
    margin-bottom: 10px;
}

.report-text {
    color: rgba(255,255,255,0.65);
    line-height: 1.8;
    font-size: 15px;
    margin-bottom: 16px;
}

.section-title {

    color: white;
    margin-bottom: 20px;
}

.analysis-box {
    padding: 28px 24px;
    border-radius: 18px;
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid rgba(255,255,255,0.07);
    backdrop-filter: blur(8px);
    transition: 0.5s ease;
}

.analysis-box:hover {
    border-color: rgba(66,165,245,0.25);
    box-shadow: 0 12px 32px rgba(0,0,0,0.25);
}

.analysis-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.80);
    font-size: 15px;
}

.analysis-item:last-child {
    border-bottom: none;
}

.analysis-box .section-title {
    font-weight: 800;
    margin-bottom: 16px;
}

.alerts-box {
    padding: 28px 24px;
    border-radius: 18px;
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid rgba(255,255,255,0.07);
    backdrop-filter: blur(8px);
    transition: 0.3s ease;
}

.alerts-box:hover {
    border-color: rgba(66,165,245,0.25);
    box-shadow: 0 12px 32px rgba(0,0,0,0.25);
}

.alert-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    color: white;
    font-weight: 600;
    font-size: 15px;
}

.alert-item:last-child {
    border-bottom: none;
}

.alerts-box .section-title {
    font-weight: 800;
    margin-bottom: 16px;
}
.summary-box {
    padding: 28px 24px;
    border-radius: 18px;
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid rgba(255,255,255,0.07);
    backdrop-filter: blur(8px);
    transition: 0.3s ease;
}

.summary-box:hover {
    border-color: rgba(66,165,245,0.25);
    box-shadow: 0 12px 32px rgba(0,0,0,0.25);
}

.summary-card {
    padding: 20px;
    border-radius: 14px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    text-align: center;
    transition: 0.3s ease;
}

.summary-card:hover {
    transform: translateY(-6px);
    background: rgba(255,255,255,0.07);
    border-color: rgba(66,165,245,0.25);
}

.summary-number {
    color: white;
    font-size: 32px;
    font-weight: 800;
    margin: 10px 0 4px 0;
}

.summary-label {
    color: rgba(255,255,255,0.60);
    font-size: 14px;
    line-height: 1.5;
}

.summary-box .section-title {
    font-weight: 800;
    margin-bottom: 16px;
}
</style>