@page "/login"

@layout EmptyLayout

<PageTitle>Vertex | Login</PageTitle>

<div class="login-container">

    <MudText Typo="Typo.h2" Class="logo-text">
        <MudImage Src="images/logo.png" Alt="Logo" Width="400" class= "justify.center" />
       
    
    </MudText>

    <MudText Typo="Typo.h5" Class="mb-6">
        Entrar
    </MudText>

    <MudPaper Class="login-box">

        <MudTextField T="string" Label="Usuário"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-6" />

        <MudTextField T="string" Label="Senha"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      Class="mb-6" />

        <div class="button-area">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary">
                Entrar
            </MudButton>
        </div>

    </MudPaper>

</div>

<style>

html, body {

    margin: 0;

    padding: 0;

    background-color: #001F3B;

    height: 100%;
}

.login-container {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transform: translateY(-40px);
    background color: #001F3B
}
.logo-text {
    color: #F5F7FA;
    margin-bottom: 8px;
}
.enter-text {

    color: #F5F7FA;
    margin-bottom: 40px;
}
.login-box {
    width: 90%;
    max-width: 650px;
    padding: 65px;
    background-color: #12385C;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.35);
}
.button-area {

    display: flex;
    justify-content: flex-end;
    margin-top: 20px;
}


.mud-button-filled-primary {

    background-color: #3B82F6 !important;

    color: white !important;

    transition: 0.2s;
}

.mud-button-filled-primary:hover {

    transform: scale(1.03);
}

.mud-input-control {

    min-height: 60px;
}

.mud-input-label {

    color: #F5F7FA;  !important;
}

.mud-input-label.mud-input-focused {

    color: #3B82F6 !important;
}

.mud-input-outlined-border {

    border-color: #3B82F6 !important;
}

.mud-input-control-input-container:focus-within .mud-input-outlined-border {

    border-color: #3B82F6 !important;
}
</style>

