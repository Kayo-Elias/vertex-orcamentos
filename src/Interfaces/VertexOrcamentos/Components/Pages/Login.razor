@page "/login"

@layout EmptyLayout

<PageTitle>Vertex | Login</PageTitle>

<div class="login-container">

    <div class="title-area">

        <MudImage Src="images/logo.png"
                  Alt="Logo"
                  Class="logo-image" />

        <MudText Typo="Typo.h5" Class="enter-text">
            Entrar
        </MudText>

    </div>

    <MudPaper Elevation="8" Class="login-box">

        <MudTextField T="string"
                      Label="Usuário"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      ShrinkLabel="true" />

        <MudTextField T="string"
                      Label="Senha"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      ShrinkLabel="true"
                      Class="mt-6" />

        <div class="button-area">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary">
                Entrar
            </MudButton>

        </div>

    </MudPaper>

</div>

<style>

html,
body {

    margin: 0;
    padding: 0;

    height: 100%;
}

.login-container {

    min-height: 100vh;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    background: linear-gradient(
        135deg,
        #071D36,
        #0B3A6A,
        #4FC3F7
    );

    padding: 40px 20px;
}

.title-area {

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;
}

.logo-image {

    width: 240px;

    max-width: 90%;

    margin-bottom: 15px;

    display: block;
}

.enter-text {

    color: #F5F7FA;

    margin-bottom: 40px;

    font-weight: 500;

    text-align: center;
}

.login-box {

    width: 90%;

    max-width: 650px;

    padding: 65px;

    background: rgba(18,56,92,0.88) !important;

    backdrop-filter: blur(10px);

    border-radius: 16px;

    box-shadow: 0 8px 25px rgba(0,0,0,0.35);
}

.button-area {

    display: flex;

    justify-content: flex-end;

    margin-top: 30px;
}

.mud-button-filled-primary {

    background-color: #3B82F6 !important;

    color: white !important;

    transition: 0.2s;
}

.mud-button-filled-primary:hover {

    transform: scale(1.03);
}

.mud-input-label {

    color: rgba(255,255,255,0.7) !important;
}

.mud-input-outlined-border {

    border-color: #3B82F6 !important;
}

.mud-input-control-input-container:focus-within .mud-input-outlined-border {

    border-color: #3B82F6 !important;
}

.mud-input-slot {

    color: white !important;
}

</style>