@page "/pedidos"
@using VertexOrcamentos.Components.Shared

<PageTitle>Vertex | Pedidos</PageTitle>

<!-- titulo -->

<PageHeader
    Titulo="Pedidos & Vendas"
    Subtitulo="Gerencie os pedidos e acompanhe o status das vendas" 
    Imagem="https://www.shutterstock.com/image-photo/female-business-leader-utilizing-crm-260nw-2688700893.jpg"
    ImagemPosicao="center 55%"/>
    

    


<!-- cards de resumo -->

 <MudGrid Class="mt-2 mb-4" Spacing="3">

    <MudItem xs="12" sm="6" md="3">

        <MudPaper Class="pa-4"
                  Elevation="0"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Total de Pedidos
            </MudText>

            <MudText Typo="Typo.h4"
                     Style="font-weight:700; color:white;">

                128

            </MudText>

        </MudPaper>

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <MudPaper Class="pa-4"
                  Elevation="0"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Pagos
            </MudText>

            <MudText Typo="Typo.h4"
                     Style="font-weight:700; color:#22C55E;">

                98

            </MudText>

        </MudPaper>

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <MudPaper Class="pa-4"
                  Elevation="0"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Pendentes
            </MudText>

            <MudText Typo="Typo.h4"
                     Style="font-weight:700; color:#FACC15;">

                12

            </MudText>

        </MudPaper>

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <MudPaper Class="pa-4"
                  Elevation="0"
                  Style="background:#111827; border-radius:16px;">

            <MudText Typo="Typo.body2" Style="color:#94A3B8;">
                Cancelados
            </MudText>

            <MudText Typo="Typo.h4"
                     Style="font-weight:700; color:#EF4444;">

                18

            </MudText>

        </MudPaper>

    </MudItem>

</MudGrid>

<!-- barra de pesquisas, filtros e botao de novo pedido -->

<MudPaper Class="pa-4 pa-sm-6"
          Elevation="0"
          Style="background-color:#111927; border-radius:16px;">

    <MudGrid Spacing="2">

    <MudItem xs="12" md="4">

        <MudTextField T="string"
              Placeholder="Pesquisar pedido"
              Variant="Variant.Outlined"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Style="border-radius:14px;"
              Margin="Margin.Dense" />
                      
    </MudItem>

    <MudItem xs="12" md="3">

       <MudSelect T="string"
           Label="Status"
           Variant="Variant.Outlined"
           Style="border-radius:14px;"
           Margin="Margin.Dense">

           <MudSelectItem Value='"Pago"'>Pago</MudSelectItem>
           <MudSelectItem Value='"Pendente"'>Pendente</MudSelectItem>
           <MudSelectItem Value='"Cancelado"'>Cancelado</MudSelectItem>

        </MudSelect>

    </MudItem>

    <MudItem xs="12" md="3">

       <MudDatePicker Label="Data"
               Variant="Variant.Outlined"
               Style="border-radius:14px;"
               Margin="Margin.Dense" />

    </MudItem>

    <MudItem xs="12" md="2" Class="d-flex align-center">

       <MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           FullWidth="true"
           Style="border-radius:12px; height:40px;">

            Novo Pedido

        </MudButton>

    </MudItem>

</MudGrid>
</MudPaper>

<!-- tabela -->

<MudPaper Elevation="8"
          Class="usuarios-box"
          Style="overflow-x:auto;">

    <MudTable Items="@pedidos"
              Hover="true"
              Striped="false"
              Bordered="false"
              Dense="false"
              Class="usuarios-table">

        <HeaderContent>

            <MudTh>Pedido</MudTh>

            <MudTh>Valor</MudTh>

            <MudTh>Status</MudTh>

            <MudTh>Ações</MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTr Class="custom-row">

                <!-- PEDIDO -->
                <MudTd>

                    <div class="user-info">

                        <MudAvatar Size="Size.Medium"
                                   Color="Color.Primary">

                            @context.Cliente.Substring(0,1)

                        </MudAvatar>

                        <div>

                            <MudText Typo="Typo.body1">
                                @context.Cliente
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Class="user-id">

                                Pedido #@context.Id

                            </MudText>

                        </div>

                    </div>

                </MudTd>

                <!-- VALOR -->
                <MudTd>

                    <MudText Typo="Typo.body1"
                             Style="font-weight:600;">

                        R$ @context.Valor.ToString("N2")

                    </MudText>

                </MudTd>

                <!-- STATUS -->
                <MudTd>

                    <MudChip T="string"
                             Color="@GetStatusColor(context.Status)"
                             Variant="Variant.Filled"
                             Size="Size.Small">

                        @context.Status

                    </MudChip>

                </MudTd>

                <!-- AÇÕES -->
                <MudTd>

                    <div class="acoes-area">

                        <MudTooltip Text="Editar">

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Default"
                                                   Style="color: #42A5F5;"
                                                   Size="Size.Small"
                                                   Class="action-btn" />

                                </MudTooltip>

                        <MudTooltip Text="Excluir">

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Class="action-btn" />

                        </MudTooltip>

                    </div>

                </MudTd>

            </MudTr>

        </RowTemplate>

    </MudTable>

</MudPaper>

<!-- estilos da pagina -->

<style>

.usuarios-box {
    background: rgba(18,56,92,0.88) !important;
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 8px 30px rgba(78, 107, 120, 0.44);
}

.user-info {
    display: flex;
    align-items: center;
    gap: 15px;
}

.user-id {
    color: rgba(255,255,255,0.55);
}

.custom-row {
    transition: 0.2s;
}

.custom-row:hover {
    background-color: rgba(255, 255, 255, 0) !important;
}

.acoes-area {
    display: flex;
    gap: 6px;
    align-items: center;
}

.action-btn {
    transition: 0.2s;
    border-radius: 10px;
}

.action-btn:hover {
    transform: scale(1.1);
    background-color: rgba(236, 173, 173, 0.08);
}

.mud-table {
    background: rgba(22, 57, 109, 0.5) !important;
}

.mud-table-head th {
    color: white !important;
    font-size: 15px;
    font-weight: 600;
    border-bottom: 1px solid rgba(151, 179, 190, 0.48);
}

.mud-table-body td {
    color: white !important;
    border-bottom: 1px solid rgba(151, 179, 190, 0.48);
}

.mud-avatar {
    background: #3B82F6 !important;
    color: white !important;
    font-weight: bold;
}

.custom-row:hover {
    background-color: rgba(255,255,255,0.06) !important;
}
</style>

@code {

    private Color GetStatusColor(string status)
{
    return status switch
    {
        "Pago" => Color.Success,
        "Pendente" => Color.Warning,
        "Cancelado" => Color.Error,
        _ => Color.Default
    };
}

    public class Pedido
    {
        public int Id { get; set; }

        public string Cliente { get; set; }

        public decimal Valor { get; set; }

        public string Status { get; set; }
    }

    private List<Pedido> pedidos = new()
    {
        new Pedido
        {
            Id = 1,
            Cliente = "João",
            Valor = 250,
            Status = "Pago"
        },

        new Pedido
        {
            Id = 2,
            Cliente = "Maria",
            Valor = 500,
            Status = "Pendente"
        }
    };
}



