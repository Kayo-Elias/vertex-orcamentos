@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Class="d-flex" Color="Color.Primary" Dense="true" Fixed="false">
        <MudStack Class="d-flex justify-start align-content-start">
            <MudLink Href="/">
                <MudImage Fluid="true" Src="images/logo.png" Width="150" Height="56" Alt="Logo" Class="rounded-lg" />
            </MudLink>
        </MudStack>

        <MudStack Row="true" Class="d-flex justify-content align-center" Spacing="3">
            <MudButton Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Description" Class="px-4 mr-2" Href="orcamentos">Orçamentos</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.People" Class="px-4 mr-2" Href="clientes">Clientes</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ShoppingCart" Class="px-4 mr-2" Href="pedidos">Pedidos</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Warehouse" Class="px-4 mr-2" Href="estoque">Estoque</MudButton>
            @if (usuarioAdmin)
            {
                <MudButton Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.AdminPanelSettings" Class="px-4 mr-2" Href="usuarios">Usuários</MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.BarChart" Class="px-4 mr-2" Href="relatorios">Relatórios</MudButton>
        </MudStack>

        <MudSpacer />

        <div class="profile-menu-wrap">
            <MudIconButton Icon="@Icons.Material.Filled.Person"
                           Color="Color.Inherit"
                           Size="Size.Medium"
                           OnClick="AlternarMenuPerfil" />

            @if (menuPerfilAberto)
            {
                <MudPaper Class="profile-menu" Elevation="8">
                    <MudText Typo="Typo.body2" Class="profile-name">@nomeUsuario</MudText>
                    <MudDivider Class="my-2" />
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Logout"
                               FullWidth="true"
                               Class="profile-exit"
                               OnClick="SairAsync">
                        Sair
                    </MudButton>
                </MudPaper>
            }
        </div>
    </MudAppBar>

    <MudMainContent Class="pt-16 pa-4">@Body</MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
.profile-menu-wrap {
    position: relative;
    display: flex;
    align-items: center;
}

.profile-menu {
    position: absolute;
    top: 48px;
    right: 0;
    min-width: 180px;
    padding: 12px;
    border-radius: 10px;
    background: #0B1F38 !important;
    border: 1px solid rgba(255,255,255,0.12);
    z-index: 2000;
}

.profile-name {
    color: white;
    font-weight: 700;
    padding: 4px 8px;
}

.profile-exit {
    justify-content: flex-start;
}
</style>

@code {
    private bool _isDarkMode = true;
    private MudTheme? _theme;
    private string nomeUsuario = "Usuário";
    private bool usuarioAdmin;
    private bool menuPerfilAberto;

    protected override void OnInitialized()
    {
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        if (path == string.Empty)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (path == "login")
        {
            return;
        }

        var login = await JS.InvokeAsync<string?>("localStorage.getItem", "vertex_user");
        if (string.IsNullOrWhiteSpace(login))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        nomeUsuario = await JS.InvokeAsync<string?>("localStorage.getItem", "vertex_user_name") ?? login;
        var perfil = await JS.InvokeAsync<string?>("localStorage.getItem", "vertex_user_role");
        usuarioAdmin = string.Equals(perfil, "Admin", StringComparison.OrdinalIgnoreCase)
            || string.Equals(perfil, "Administrador", StringComparison.OrdinalIgnoreCase);
        StateHasChanged();
    }

    private async Task SairAsync()
    {
        menuPerfilAberto = false;
        await JS.InvokeVoidAsync("localStorage.removeItem", "vertex_user");
        await JS.InvokeVoidAsync("localStorage.removeItem", "vertex_user_name");
        await JS.InvokeVoidAsync("localStorage.removeItem", "vertex_user_role");
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void AlternarMenuPerfil()
    {
        menuPerfilAberto = !menuPerfilAberto;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#1C1C1C",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#0B3A6A",
        Secondary = "#F5E900",
        Tertiary = "#ffffff",
        Surface = "#071D36",
        Background = "#000C18",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "#00152E",
        DrawerBackground = "#000814",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#F4F8FC",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#ffffff",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };
}
